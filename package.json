{
  "name": "paiflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs",
    "prebuild": "node scripts/check-node-version.cjs",
    "dev": "next dev",
    "build": "prisma generate && DATABASE_URL=\"${DATABASE_URL:-postgresql://dummy:dummy@localhost:5432/dummy?schema=public}\" next build",
    "start": "sh scripts/start-railway.sh",
    "lint": "next lint",
    "format": "prettier --write .",
    "homepage:css": "tsx scripts/build-homepage-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --reporter=github-actions --outputFile.junit=reports/vitest-junit.xml",
    "test:sse-shutdown": "node tests/sse-shutdown.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=chromium-desktop screenshots.spec.ts",
    "screenshots:mobile": "playwright test --project=mobile screenshots.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev-token:create": "tsx scripts/create-dev-api-token.ts",
    "hackathon:wallets": "tsx --conditions=react-server scripts/hackathon-wallets.ts",
    "testers:seed-sql": "tsx scripts/seed-testers.ts",
    "testers:seed-flow-sql": "tsx scripts/seed-tester-flows.ts",
    "api:openapi": "tsx scripts/print-openapi.ts > docs/api/openapi.json && prettier --write docs/api/openapi.json",
    "demo:check": "tsx scripts/check-demo-deployment.ts",
    "relayer:audit-urls": "tsx scripts/audit-charge-relayer-urls.ts",
    "relayer:channels": "tsx scripts/relayer-channels.ts",
    "docs:pdf": "tsx scripts/render-guide-pdf.ts",
    "contracts:build": "cd contracts && cargo build --release --target wasm32v1-none",
    "contracts:upload": "tsx scripts/upload-wasm.ts",
    "contracts:upload:testnet": "tsx scripts/upload-wasm.ts --network=testnet",
    "contracts:upload:mainnet": "tsx scripts/upload-wasm.ts --network=mainnet",
    "contracts:update-hashes": "tsx scripts/update-hashes.ts",
    "contracts:extend-ttl": "tsx scripts/extend-wasm-ttl.ts",
    "contracts:show-factory": "tsx scripts/show-factory.ts",
    "soroswap:check": "tsx scripts/soroswap-check.ts",
    "instawards:changelog": "tsx scripts/instawards-changelog.ts",
    "analytics:metrics": "tsx --conditions=react-server scripts/usage-metrics-v2.ts",
    "analytics:snapshot": "node --conditions=react-server --import tsx scripts/analytics-snapshot.ts",
    "analytics:api-report": "node --conditions=react-server --import tsx scripts/api-request-report.ts",
    "preanalytics:api-daily-cron": "node scripts/check-node-version.cjs",
    "analytics:api-daily-cron": "node --conditions=react-server --import tsx scripts/api-daily-cron.ts",
    "instawards:metrics": "tsx scripts/instawards-metrics.ts",
    "instawards:transactions": "tsx scripts/instawards-transactions.ts",
    "instawards:alpha-metrics": "tsx scripts/alpha-metrics.ts",
    "contracts:deploy-factory": "tsx scripts/deploy-factory.ts",
    "contracts:deploy-factory:testnet": "tsx scripts/deploy-factory.ts --network=testnet",
    "contracts:deploy-factory:mainnet": "tsx scripts/deploy-factory.ts --network=mainnet",
    "contracts:deploy": "pnpm contracts:build && pnpm contracts:upload && pnpm contracts:deploy-factory && pnpm contracts:update-hashes",
    "contracts:deploy:testnet": "pnpm contracts:build && pnpm contracts:upload:testnet && pnpm contracts:deploy-factory:testnet && pnpm contracts:update-hashes",
    "contracts:deploy:mainnet": "pnpm contracts:build && pnpm contracts:upload:mainnet && pnpm contracts:deploy-factory:mainnet && pnpm contracts:update-hashes",
    "contracts:estimate": "bash scripts/build-estimate-mainnet.bash",
    "db:seed:events": "tsx scripts/seed-events.ts",
    "db:seed:all-events": "tsx scripts/seed-all-events.ts",
    "docker:up": "docker compose --profile full up -d",
    "docker:down": "docker compose down -v",
    "prepare": "husky || true",
    "sdk:build": "pnpm --dir packages/sdk run build",
    "sdk:typecheck": "pnpm --dir packages/sdk run typecheck",
    "sdk:test:package": "pnpm --dir packages/sdk run test:package",
    "sdk:test": "pnpm --dir packages/sdk run test",
    "sdk:docs": "node packages/sdk/scripts/generate-reference.mjs",
    "sdk:docs:check": "node packages/sdk/scripts/generate-reference.mjs --check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@stellar/stellar-sdk": "^16.3.1",
    "@tanstack/react-query": "^5.62.7",
    "@walletconnect/modal": "2.7.0",
    "@walletconnect/sign-client": "2.26.0",
    "@xyflow/react": "^12.4.1",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "minio": "^8.0.3",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pino": "^9.5.0",
    "posthog-js": "^1.433.4",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.1.0",
    "railway": "^3.11.0",
    "tailwindcss": "^4.0.0-beta.8",
    "tsx": "^4.19.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-848j-6mx2-7j84",
        "GHSA-528h-pc64-c93x"
      ]
    },
    "overrides": {
      "protobufjs": ">=7.6.3 <8",
      "axios": ">=1.18.0 <2",
      "follow-redirects": ">=1.16.1 <2",
      "ws": ">=8.21.0 <9",
      "form-data": ">=4.0.6 <5",
      "ua-parser-js": ">=2.0.10 <3",
      "uuid": ">=11.1.1 <12",
      "postcss": ">=8.5.23 <9",
      "js-yaml": ">=4.3.2 <5",
      "vite": ">=6.4.4 <7",
      "jsdom>undici": ">=8.12.2 <9",
      "esbuild": ">=0.28.1 <0.29",
      "brace-expansion": ">=1.1.21 <2",
      "dompurify": ">=3.4.17 <4",
      "nanoid": ">=3.3.19 <4",
      "ip-address": ">=10.7.4 <11",
      "toml": ">=5.0.1 <6",
      "browserslist": ">=4.28.7 <5",
      "baseline-browser-mapping": ">=2.11.22 <3",
      "deepmerge-ts": ">=8.0.0 <9",
      "decode-uri-component": ">=0.5.0 <1",
      "sharp": ">=0.35.5 <0.36",
      "@auth/core": ">=0.41.3 <0.42",
      "source-map-js": ">=1.2.2 <2",
      "fast-copy": ">=4.1.0 <5",
      "jayson": ">=5.0.0 <6",
      "stream-json": ">=3.6.0 <4",
      "@creit.tech/stellar-wallets-kit>@walletconnect/sign-client": "2.26.0",
      "@creit.tech/stellar-wallets-kit>@walletconnect/modal": "2.7.0",
      "minimatch@10>brace-expansion": ">=5.0.12 <6"
    },
    "patchedDependencies": {
      "minio@8.0.7": "patches/minio@8.0.7.patch"
    }
  }
}
