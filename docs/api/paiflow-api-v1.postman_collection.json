          ],
          "body": "{\n  \"data\": {\n    \"txHash\": \"94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d\",\n    \"status\": \"FAILED\",\n    \"ledger\": 1842917,\n    \"error\": {\n      \"code\": \"txTooLate\",\n      \"message\": \"The transaction's 180-second window expired before it reached the network. Prepare it again.\"\n    }\n  }\n}"
        }
      ]
    },
    {
      "name": "List events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deployments/{{deploymentId}}/events?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "deployments", "{{deploymentId}}", "events"],
          "query": [
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "cursor",
              "value": "{{cursor}}",
              "disabled": true,
              "description": "Enable once `cursor` holds a nextCursor (the test script sets it)."
            },
            {
              "key": "txHash",
              "value": "{{txHash}}",
              "disabled": true,
              "description": "Only events from this transaction."
            }
          ]
        },
        "description": "Forward-paginated events the app decoded for this deployment's contracts, ascending by `(ledger, eventId)`. This is the app's record, not a raw chain feed: each event appears once (`eventId` is unique), and it can trail the chain by about a minute, because events arrive from a one-minute poller (a confirmed `execute/submit` ingests its own events straight away).\n\nA swap is `kind: PAYOUT` with `topic: \"swap\"` and `data` `{ assetIn, assetOut, amountIn, amountOut }`; amounts are stroops as strings.\n\nTo poll: store `nextCursor` and pass it back as `cursor`. While `hasMore` is true, ask again straight away; once it is false, wait and ask again with the same cursor. `nextCursor` is never null once the deployment has events: on an empty page it echoes the cursor you sent. It is null only when there are no events and no cursor was sent.\n\nRate limit: 120 requests per 60 seconds per token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns a page of events', () => {",
              "  pm.response.to.have.status(200);",
              "  const { data } = pm.response.json();",
              "  pm.expect(data.items).to.be.an('array');",
              "  if (data.nextCursor) pm.collectionVariables.set('cursor', data.nextCursor);",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/deployments/{{deploymentId}}/events?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deployments", "{{deploymentId}}", "events"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true,
                  "description": "Enable once `cursor` holds a nextCursor (the test script sets it)."
                },
                {
                  "key": "txHash",
                  "value": "{{txHash}}",
                  "disabled": true,
                  "description": "Only events from this transaction."
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"data\": {\n    \"items\": [\n      {\n        \"id\": \"0c9d7a3e-5b1f-4e2a-8d6c-7f4b3a2e1d0c\",\n        \"eventId\": \"0007915171594088448-0000000001\",\n        \"kind\": \"RECEIVE\",\n        \"topic\": \"deposit\",\n        \"ledger\": 1842917,\n        \"txHash\": \"94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d\",\n        \"occurredAt\": \"2026-09-15T09:00:12.000Z\",\n        \"data\": {\n          \"from\": \"GDMFZ5QQMDSOTPEQ6YCAWPFAB626Q6C3KLRLYMO3VWMWHQHL4L2DSIHY\",\n          \"amount\": \"1000000000\"\n        }\n      },\n      {\n        \"id\": \"1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d\",\n        \"eventId\": \"0007915171594088448-0000000004\",\n        \"kind\": \"PAYOUT\",\n        \"topic\": \"swap\",\n        \"ledger\": 1842917,\n        \"txHash\": \"94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d\",\n        \"occurredAt\": \"2026-09-15T09:00:12.000Z\",\n        \"data\": {\n          \"assetIn\": \"CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC\",\n          \"assetOut\": \"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA\",\n          \"amountIn\": \"1000000000\",\n          \"amountOut\": \"105594796\"\n        }\n      }\n    ],\n    \"nextCursor\": \"MTg0MjkxN3wwMDA3OTE1MTcxNTk0MDg4NDQ4LTAwMDAwMDAwMDQ\",\n    \"hasMore\": false\n  }\n}"
        }
      ]
    }
  ]
