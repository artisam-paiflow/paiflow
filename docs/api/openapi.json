{
  "openapi": "3.1.0",
  "info": {
    "title": "Paiflow API v1",
    "version": "1.0.0",
    "description": "Execute a deployed swapper flow and poll its on-chain events from your own backend.\n\nEvery `/api/v1/deployments/{id}/…` call authenticates with a deployment API token (`Authorization: Bearer pfk_…`) that the deployment's owner mints in the **API access** panel on the deployment page. A token reaches exactly one deployment.\n\n**The API never signs.** `execute` returns an unsigned envelope; you sign it with the `from` key, which stays on your side, and post it to `execute/submit`. A leaked token can only prepare and relay what you signed.\n\nSuccessful responses are `{ \"data\": … }`. Errors are `{ \"error\": { code, message, fields?, details? } }`:\n\n| Code | HTTP status |\n| --- | --- |\n| `UNAUTHENTICATED` | 401 |\n| `INSUFFICIENT_FUNDS` | 402 |\n| `FORBIDDEN` | 403 |\n| `NOT_FOUND` | 404 |\n| `CONFLICT` | 409 |\n| `VALIDATION` | 422 |\n| `RATE_LIMITED` | 429 |\n| `INTERNAL` | 500 |\n| `UPSTREAM_RPC` | 502 |\n\nThe public instance runs on Stellar **testnet**. Guide: `docs/api/README.md`."
  },
  "servers": [
    {
      "url": "https://paiflow.xyz",
      "description": "Public instance (Stellar testnet)"
    }
  ],
  "tags": [
    {
      "name": "Execute",
      "description": "Run a swapper flow: prepare, sign on your side, submit."
    },
    {
      "name": "Events",
      "description": "Cursor-based polling of a deployment's decoded events."
    },
    {
      "name": "Spec",
      "description": "This document."
    },
    {
      "name": "Token management (owner session)",
      "description": "How deployment tokens are minted and revoked. These are the owner's signed-in session routes behind the API access panel, not part of the token-authenticated API: they take the session cookie, never a deployment token, and a sandbox session is refused."
    }
  ],
  "paths": {
    "/api/v1/deployments/{id}/execute": {
      "post": {
        "tags": ["Execute"],
        "operationId": "prepareExecute",
        "summary": "Prepare the unsigned deposit that executes a swapper flow",
        "description": "Prepare the deposit that executes a swapper flow. `from` must be a funded account on this network: it pays the deposit and the fee, and signs the envelope. The flow's payout recipient must hold a trustline for the asset it receives; a missing trustline reverts the whole pipeline.\n\nThe flow runs through its deposit trigger; the swapper executes as the next pipeline step. Sign the returned `xdr` with the `from` key using `networkPassphrase`, before `expiresAt`, and post it to `execute/submit`. Only swapper flows can be executed.\n\nRate limit: 30 requests per 60 seconds per token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Deployment id (UUID). A malformed id is a 404.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "6b1f0c52-3d4e-4a8b-9c7d-2e5f8a1b3c4d"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutePrepareRequest"
              },
              "example": {
                "amount": "1000000000",
                "from": "GDMFZ5QQMDSOTPEQ6YCAWPFAB626Q6C3KLRLYMO3VWMWHQHL4L2DSIHY"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The unsigned envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ExecutePrepared"
                    }
                  }
                },
                "example": {
                  "data": {
                    "xdr": "AAAAAgAAAADYXPYQYOTpvJD2BAs8oB9ej3hbUuLzjbut2WPA6+L0OQAB6IQADc4pAAAAAQAAAAEAAAAAAAAAAAAAAABmxy2kAAAAAAAAAAEAAAAAAAAAGAAAAAAAAAAB…(truncated)",
                    "networkPassphrase": "Test SDF Network ; September 2015",
                    "network": "testnet",
                    "expiresAt": "2026-09-15T09:03:00.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: Missing, unknown, revoked or expired token, or a token for another deployment. One message for every case.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "A valid API token for this deployment is required"
                  }
                }
              }
            }
          },
          "402": {
            "description": "`INSUFFICIENT_FUNDS`: The `from` account does not exist on this network.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: Malformed deployment id, or a deployment that is not (or no longer) confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`VALIDATION`: The body or query failed validation (`fields` names each problem), or the network refused the request as built.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION",
                    "message": "Invalid input",
                    "fields": {
                      "amount": ["Must be a whole number of stroops"]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`: Too many requests in the window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "`UPSTREAM_RPC`: The Soroban RPC request failed or the network was busy; retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deployments/{id}/execute/submit": {
      "post": {
        "tags": ["Execute"],
        "operationId": "submitExecute",
        "summary": "Submit the signed deposit and wait for the result",
        "description": "Submit a signed deposit that executes a swapper flow.\n\nThe envelope must be the one `execute` returned, signed by `from`: anything but a single `deposit` call on this flow's trigger contract is refused with `VALIDATION`, as is a fee-bump envelope.\n\nIdempotent on the envelope hash: submitting the same `signedXdr` again never sends a second transaction, it reports the one already on the network. That is also how to check a `PENDING` result. A transaction that reached the network and failed is a `200` with `status: FAILED` and an `error`, not an HTTP error.\n\nRate limit: 30 requests per 60 seconds per token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Deployment id (UUID). A malformed id is a 404.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "6b1f0c52-3d4e-4a8b-9c7d-2e5f8a1b3c4d"
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "description": "`false` returns PENDING as soon as the network accepts the transaction. Default `true`: wait up to about 25 seconds for a final status, then return `PENDING` if there is none yet.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"],
              "default": "true"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteSubmitRequest"
              },
              "example": {
                "signedXdr": "AAAAAgAAAADYXPYQYOTpvJD2BAs8oB9ej3hbUuLzjbut2WPA6+L0OQAB6IQADc4pAAAAAQAAAAEAAAAAAAAAAAAAAABmxy2kAAAAAAAAAAEAAAAAAAAAGAAAAAAAAAAB…(truncated)"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The outcome: `SUCCESS`, `PENDING` or `FAILED`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ExecuteSubmitted"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "summary": "Confirmed",
                    "value": {
                      "data": {
                        "txHash": "94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d",
                        "status": "SUCCESS",
                        "ledger": 1842917
                      }
                    }
                  },
                  "pending": {
                    "summary": "Accepted, not final yet",
                    "value": {
                      "data": {
                        "txHash": "94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d",
                        "status": "PENDING"
                      }
                    }
                  },
                  "failed": {
                    "summary": "Reached the network and failed",
                    "value": {
                      "data": {
                        "txHash": "94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d",
                        "status": "FAILED",
                        "ledger": 1842917,
                        "error": {
                          "code": "txTooLate",
                          "message": "The transaction's 180-second window expired before it reached the network. Prepare it again."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: Missing, unknown, revoked or expired token, or a token for another deployment. One message for every case.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "A valid API token for this deployment is required"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: Malformed deployment id, or a deployment that is not (or no longer) confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`VALIDATION`: The body or query failed validation (`fields` names each problem), or the network refused the request as built.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION",
                    "message": "Invalid input",
                    "fields": {
                      "amount": ["Must be a whole number of stroops"]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`: Too many requests in the window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "`UPSTREAM_RPC`: The Soroban RPC request failed or the network was busy; retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deployments/{id}/events": {
      "get": {
        "tags": ["Events"],
        "operationId": "listEvents",
        "summary": "Poll the deployment's events, oldest first",
        "description": "Forward-paginated events the app decoded for this deployment's contracts, ascending by `(ledger, eventId)`. This is the app's record, not a raw chain feed: each event appears once (`eventId` is unique), and it can trail the chain by about a minute, because events arrive from a one-minute poller (a confirmed `execute/submit` ingests its own events straight away).\n\nA swap is `kind: PAYOUT` with `topic: \"swap\"` and `data` `{ assetIn, assetOut, amountIn, amountOut }`; amounts are stroops as strings.\n\nTo poll: store `nextCursor` and pass it back as `cursor`. While `hasMore` is true, ask again straight away; once it is false, wait and ask again with the same cursor. `nextCursor` is never null once the deployment has events: on an empty page it echoes the cursor you sent. It is null only when there are no events and no cursor was sent.\n\nRate limit: 120 requests per 60 seconds per token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Deployment id (UUID). A malformed id is a 404.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "6b1f0c52-3d4e-4a8b-9c7d-2e5f8a1b3c4d"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from a previous response's `nextCursor`. Omit to start from the first event. An empty or altered value is a 422.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "txHash",
            "in": "query",
            "required": false,
            "description": "Only events from this transaction, e.g. the `txHash` `execute/submit` returned.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ListEventsResponse"
                    }
                  }
                },
                "example": {
                  "data": {
                    "items": [
                      {
                        "id": "0c9d7a3e-5b1f-4e2a-8d6c-7f4b3a2e1d0c",
                        "eventId": "0007915171594088448-0000000001",
                        "kind": "RECEIVE",
                        "topic": "deposit",
                        "ledger": 1842917,
                        "txHash": "94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d",
                        "occurredAt": "2026-09-15T09:00:12.000Z",
                        "data": {
                          "from": "GDMFZ5QQMDSOTPEQ6YCAWPFAB626Q6C3KLRLYMO3VWMWHQHL4L2DSIHY",
                          "amount": "1000000000"
                        }
                      },
                      {
                        "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
                        "eventId": "0007915171594088448-0000000004",
                        "kind": "PAYOUT",
                        "topic": "swap",
                        "ledger": 1842917,
                        "txHash": "94be52e8a937b6ddcb85da7cd917f97d412753e5e3ca47ea48b252a264b2278d",
                        "occurredAt": "2026-09-15T09:00:12.000Z",
                        "data": {
                          "assetIn": "CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC",
                          "assetOut": "CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA",
                          "amountIn": "1000000000",
                          "amountOut": "105594796"
                        }
                      }
                    ],
                    "nextCursor": "MTg0MjkxN3wwMDA3OTE1MTcxNTk0MDg4NDQ4LTAwMDAwMDAwMDQ",
                    "hasMore": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: Missing, unknown, revoked or expired token, or a token for another deployment. One message for every case.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "A valid API token for this deployment is required"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: Malformed deployment id, or a deployment that is not (or no longer) confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "`VALIDATION`: The body or query failed validation (`fields` names each problem), or the network refused the request as built.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION",
                    "message": "Invalid input",
                    "fields": {
                      "amount": ["Must be a whole number of stroops"]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`: Too many requests in the window.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": ["Spec"],
        "operationId": "getOpenApi",
        "summary": "This OpenAPI document",
        "description": "Public; no token. Returned as the bare document, without the `data` envelope. Rate limit: 60 requests per 60 seconds per client IP.",
        "security": [],
