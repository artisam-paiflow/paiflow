generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  SANDBOX
}

enum TemplateKind {
  SPLITTER
  STREAMER
  CONDITIONAL
  DEPOSIT_TRIGGER
  ROUTER
  TIMELOCK
  FACTORY
  WEBHOOK
  SUBSCRIPTION
  ORACLE
  MULTISIG
  SWAPPER
  YIELD
  PAYER
  PAYROLL
  PAYER_DEV
  SPLITTER_DEV
  SUBSCRIPTION_DEV
  CASH_OUT_DEV
  CASH_OUT
  /// A timelock with a "before" and an "after" next step (#721). Its own kind,
  /// so TIMELOCK contracts already deployed keep their ABI.
  TIMELOCK_BRANCH
}

enum DeploymentStatus {
  DRAFT
  BUILDING
  PENDING_SIGNATURE
  SUBMITTED
  CONFIRMED
  FAILED
}

enum StreamerClaimJobStatus {
  PENDING
  RUNNING
  CLAIMED
  SKIPPED
  FAILED
  CANCELLED
}

enum ChargeRelayerMode {
  PLATFORM
  USER
  MANUAL
}

enum OffRampJobSource {
  PAYROLL
  CASH_OUT
}

enum OffRampPayoutJobStatus {
  PENDING
  RUNNING
  QUOTED
  INITIATED
  COMPLETED
  FAILED
  CANCELLED
}

enum PayrollRunStatus {
  PENDING
  CHARGED
  FAILED
  CANCELLED
}

enum EventKind {
  RECEIVE
  PAYOUT
  CLAIM
  STATUS_CHANGE
  CANCEL
  SHORTFALL
  PAUSE
  RESUME
  FORWARD
  RETRIEVE
  ALLOWANCE
  RECIPIENT_UPDATED
  CASH_OUT
}

enum AnalyticsAudience {
  INTERNAL
  EXTERNAL
  SANDBOX
  UNCLASSIFIED
}

enum TransactionOutcome {
  RECEIVED
  ACCEPTED
  UNRESOLVED
  REJECTED
  CONFIRMED
  FAILED
}

model AnalyticsPolicy {
  version     String   @id
  activatedAt DateTime @default(now())
}

model WalletConnection {
  id              String            @id @db.Uuid
  address         String
  network         String
  walletProvider  String
  surface         String
  userId          String?           @db.Uuid
  audience        AnalyticsAudience
  trackingVersion String
  createdAt       DateTime          @default(now())
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackingVersion, network, audience, createdAt])
  @@index([address, createdAt])
  @@index([userId, createdAt])
}

model AnalyticsDelivery {
  id            String    @id @db.Uuid
  distinctId    String
  event         String
  properties    Json
  personProfile Boolean   @default(false)
  occurredAt    DateTime  @default(now())
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())

  @@index([deliveredAt, nextAttemptAt])
  @@index([event, occurredAt])
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  username       String    @unique
  email          String?   @unique
  passwordHash   String?
  role           Role      @default(USER)
  isActive       Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  /// Sessions are stateless JWTs, so nothing server-side can be deleted to end
  /// one. Each token carries the value this had at login and getSessionUser()
  /// refuses a token whose value differs; incrementing it signs the user out
  /// everywhere.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  googleIdentities    GoogleIdentity[]
  googleLinkIntents   GoogleLinkIntent[]
  flows               Flow[]
  deployments         Deployment[]
  passkeys            Passkey[]
  sessions            Session[]
  auditLogs           AuditLog[]
  files               FileAsset[]
  addressBookEntries  AddressBookEntry[]
  passwordResetTokens PasswordResetToken[]
  developerApiTokens  DeveloperApiToken[]
  devApiTokens        DevApiToken[]
  deploymentApiTokens DeploymentApiToken[]
  signedTransactions  SignedTransaction[]  @relation("signingSession")
  callerTransactions  SignedTransaction[]  @relation("transactionCaller")
  walletConnections   WalletConnection[]
  analyticsAudience   AnalyticsAudience    @default(UNCLASSIFIED)
}

/// A per-developer API token that maps a machine caller to a Paiflow user.
/// The only machine credential the dev-auth endpoints accept: every one of them
/// filters on the owner it resolves to. Only the SHA-256 hash of the token is
/// stored; the plaintext is shown once at creation time.
model DevApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A partner API token bound to exactly one deployment; the only credential
/// `/api/v1` accepts (`lib/api/v1/auth.ts`). Only the SHA-256 hash is stored;
/// the plaintext is shown once at creation. Revoked rows are kept, never
/// deleted, so the audit trail keeps its subject.
model DeploymentApiToken {
  id           String    @id @default(uuid()) @db.Uuid
  deploymentId String    @db.Uuid
  createdById  String?   @db.Uuid
  tokenHash    String    @unique
  tokenPrefix  String
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?

  deployment         Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  signedTransactions SignedTransaction[]

  @@index([deploymentId])
}

enum DeveloperTokenPermission {
  READ_ONLY
  READ_OPERATE
}

/// Explicitly scoped partner credential, separate from legacy DevApiToken.
/// Revocation retains the row and durable transaction attribution.
model DeveloperApiToken {
  id                 String                   @id @default(uuid()) @db.Uuid
  ownerId            String                   @db.Uuid
  tokenHash          String                   @unique
  tokenPrefix        String
  label              String?
  permission         DeveloperTokenPermission
  createdAt          DateTime                 @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  owner              User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  grants             DeveloperTokenGrant[]
  signedTransactions SignedTransaction[]

  @@index([ownerId, id])
}

model DeveloperTokenGrant {
  tokenId      String            @db.Uuid
  deploymentId String            @db.Uuid
  token        DeveloperApiToken @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  deployment   Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Restrict)

  @@id([tokenId, deploymentId])
  @@index([deploymentId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model AddressBookEntry {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  label     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, label])
  @@index([ownerId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId Bytes     @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean
  transports   String[]
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flow {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @db.Uuid
  name         String
  description  String?
  templateKind TemplateKind
  graph        Json
  parameters   Json
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@index([ownerId, updatedAt(sort: Desc)])
}

model ContractTemplate {
  id         String       @id @default(uuid()) @db.Uuid
  kind       TemplateKind
  wasmHash   String
  network    String
  abiJson    Json
  uploadedAt DateTime     @default(now())

  @@unique([kind, network])
}

model FactoryDeployment {
  network   String   @id
  address   String
  wasmHash  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum DeploymentServiceState {
  ACTIVE
  RETIRING
  RETIRED
}

enum DeploymentWorkState {
  OPEN
  DONE
  BLOCKED
}

enum ServiceTransactionState {
  PENDING
  SUCCESS
  FAILED
  REJECTED
}

model Deployment {
  id                      String                 @id @default(uuid()) @db.Uuid
  flowId                  String                 @db.Uuid
  ownerId                 String                 @db.Uuid
  network                 String
  contractAddress         String?                @unique
  deployTxHash            String?                @unique
  serviceState            DeploymentServiceState @default(ACTIVE)
  retirementRequestedAt   DateTime?
  retiredAt               DateTime?
  retirementCutoffLedger  Int?
  retirementReconciledAt  DateTime?
  retirementCoverageGap   String?
  retirementBlocker       String?
  retirementCheckedAt     DateTime?
  developerTokenGrants    DeveloperTokenGrant[]
  serviceWork             DeploymentWork[]
  status                  DeploymentStatus       @default(DRAFT)
  errorMessage            String?
  graphSnapshot           Json
  paramsSnapshot          Json
  pipelineSnapshot        Json?
  createdAt               DateTime               @default(now())
  confirmedAt             DateTime?
  unsignedXdr             String?
  sourceAccount           String?
  distributeAmountStroops String?
  webhookSecret           String?
  chargeRelayerMode       ChargeRelayerMode      @default(MANUAL)
  chargeRelayerUrl        String?
  chargeRelayerToken      String?
  chargeRelayerAddress    String?
  nextChargeAt            DateTime?
  lastChargedAt           DateTime?
  chargeEndAt             DateTime?
  offRampEnabled          Boolean                @default(false)
  // Client-supplied key that makes deploy creation idempotent per owner. A
  // retry with the same key returns the existing deployment instead of
  // deploying a second set of contracts. NULL for endpoints that don't opt in.
  idempotencyKey          String?
  // Stamped by cron/poll-events after every poll attempt, success or failure,
  // so a deployment whose scan always fails rotates to the back instead of
  // holding a batch slot forever (EventCursor.updatedAt only moves on success).
  eventsPolledAt          DateTime?
  // TTL inventory attempts rotate durably, including failed reads.
  ttlCheckedAt            DateTime?
  // Position within a large durable pipeline; each inventory reads one instance.
  ttlScanOffset           Int                    @default(0)

  flow                 Flow                  @relation(fields: [flowId], references: [id], onDelete: Restrict)
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  events               ContractEvent[]
  cursor               EventCursor?
  streamerClaimJobs    StreamerClaimJob[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  offRampPayoutJobs    OffRampPayoutJob[]
  offRampSenderProfile OffRampSenderProfile?
  cashOutJobFailures   CashOutJobFailure[]
  apiTokens            DeploymentApiToken[]
  signedTransactions   SignedTransaction[]
  timelockReleases     TimelockRelease[]
  webhookAttempts      WebhookAttempt[]
  walletControlIntents WalletControlIntent[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status, serviceState, id])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, nextChargeAt])
  @@index([status, chargeRelayerMode, nextChargeAt])
  @@index([chargeRelayerMode])
  @@index([serviceState, ownerId, createdAt(sort: Desc)])
  @@index([serviceState, status, nextChargeAt])
  @@index([serviceState, status, eventsPolledAt])
  @@index([serviceState, retirementCheckedAt])
  @@index([serviceState, network, status, ttlCheckedAt, id])
  @@index([status, eventsPolledAt])
  @@index([network, status, ttlCheckedAt, id])
}

model StreamerClaimJob {
  id              String                 @id @default(uuid()) @db.Uuid
  deploymentId    String                 @db.Uuid
  nodeId          String
  contractAddress String
  runAt           DateTime
  status          StreamerClaimJobStatus @default(PENDING)
  attemptCount    Int                    @default(0)
  lastError       String?
  claimedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([runAt])
  @@index([deploymentId, nodeId, status])
  @@index([contractAddress, status])
}

enum TimelockMode {
  AFTER
  BEFORE
}

/// What `cron/auto-release` knows about one deployed timelock, so a tick probes
/// only the timelocks that can release now instead of simulating every one ever
/// deployed (#564). A timelock is not "done" after one release: its balance
/// goes back to zero and a later `execute_step` refills it, so the row records
/// the ledger up to which the contract was last seen empty (`settledLedger`)
/// and a RECEIVE event after that ledger makes it due again.
///
/// Rows are created by the cron itself from `paramsSnapshot` the first time it
/// sees a confirmed deployment with a timelock, so older deployments need no
/// backfill.
model TimelockRelease {
  id                String        @id @default(uuid()) @db.Uuid
  deploymentId      String        @db.Uuid
  nodeId            String
  contractAddress   String        @unique
  templateKind      TemplateKind
  /// Null only on an unsupported row whose parameters could not be read. A
  /// TIMELOCK_BRANCH row is AFTER: the relayer can only release it at or after
  /// the deadline, when it pays the contract's "after" list.
  mode              TimelockMode?
  /// The contract's `unlock_time`. AFTER releases from this instant on; BEFORE
  /// releases up to and including it and never after.
  unlockAt          DateTime?
  /// Earliest time the cron probes this timelock again without a new RECEIVE.
  nextProbeAt       DateTime?
  /// Ledger through which the balance is known to be zero: the ledger a
  /// NothingToRelease simulation read, or the one before a release that landed
  /// (a refill later in the release's own ledger must still wake it).
  settledLedger     Int?
  lastReleasedAt    DateTime?
  lastReleaseTxHash String?
  failureCount      Int           @default(0)
  lastError         String?
  /// Set when the relayer can never release this contract (a timelock deployed
  /// with relayer == admin, or a WASM without `release_by_relayer`). Such a row
  /// is never selected again.
  unsupportedReason String?
  /// Claimed by a run while it probes, so overlapping runs (a second replica,
  /// a retried cron call) do not both simulate and submit the same release.
  leaseUntil        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([nextProbeAt])
}

enum SignedTxKind {
  DEPLOY
  TRIGGER
  INVOKE
  API_EXECUTE
}

enum EmployeePayoutMode {
  CRYPTO
  FIAT
}

model Employee {
  id                     String             @id @default(uuid()) @db.Uuid
  deploymentId           String             @db.Uuid
  address                String
  amountStroops          String
  label                  String?
  payoutMode             EmployeePayoutMode @default(CRYPTO)
  cashOutContractAddress String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  deployment  Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  payouts     PayrollPayout[]
  bankDetail  EmployeeBankDetail?
  offRampJobs OffRampPayoutJob[]

  @@unique([deploymentId, address])
  @@index([deploymentId])
  @@index([cashOutContractAddress])
}

model EmployeeBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @unique @db.Uuid
  accountName   String
  accountNumber String
  bankCode      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model PayrollRun {
  id           String           @id @default(uuid()) @db.Uuid
  deploymentId String           @db.Uuid
  runAt        DateTime
  status       PayrollRunStatus @default(PENDING)
  attemptCount Int              @default(0)
  lastError    String?
  txHash       String?          @unique
  totalStroops String
  chargedAt    DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deployment  Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  payouts     PayrollPayout[]
  offRampJobs OffRampPayoutJob[]

  @@index([deploymentId, runAt])
  @@index([deploymentId, createdAt])
  @@index([status, runAt])
  @@index([runAt])
}

model PayrollPayout {
  id            String   @id @default(uuid()) @db.Uuid
  payrollRunId  String   @db.Uuid
  employeeId    String   @db.Uuid
  amountStroops String
  txHash        String?
  createdAt     DateTime @default(now())

  payrollRun  PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  offRampJobs OffRampPayoutJob[]

  @@index([payrollRunId])
  @@index([employeeId])
}

model OffRampPayoutJob {
  originatingEventId   String?                @unique @db.Uuid
  originatingEvent     ContractEvent?         @relation(fields: [originatingEventId], references: [id], onDelete: Restrict)
  id                   String                 @id @default(uuid()) @db.Uuid
  source               OffRampJobSource       @default(PAYROLL)
  deploymentId         String                 @db.Uuid
  sourceAddress        String?
  amountStroops        String
  bankAccountName      String?
  bankAccountNumber    String?
  bankCode             String?
  payrollRunId         String?                @db.Uuid
  employeeId           String?                @db.Uuid
  payrollPayoutId      String?                @db.Uuid
  status               OffRampPayoutJobStatus @default(PENDING)
  providerRef          String? // withdrawal identifier
  tradeRef             String? // order/trade reference
  requestId            String? // provider request id
  pdaxDepositTxHash    String? // native-XLM->PDAX deposit tx (idempotency guard)
  providerQuote        Json?
  runAt                DateTime
  lockedAt             DateTime? // lease stamp for the atomic RUNNING claim (see claimOffRampJob)
  attemptCount         Int                    @default(0)
  lastError            String?
  settlementResolvedAt DateTime?
  settlementEvidence   String?
  completedAt          DateTime?
  quotedAt             DateTime?
  initiatedAt          DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  deployment    Deployment     @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun?    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee      Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPayout PayrollPayout? @relation(fields: [payrollPayoutId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([runAt])
  @@index([status, runAt, lockedAt])
  @@index([deploymentId])
  @@index([deploymentId, status])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([providerRef])
  @@index([tradeRef])
  @@index([requestId])
}

model OffRampSenderProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  deploymentId           String   @unique @db.Uuid
  firstName              String
  middleName             String   @default("n.a.")
  lastName               String
  countryOrigin          String
  addressLineOne         String?
  addressLineTwo         String?
  city                   String?
  province               String?
  country                String?
  zipCode                String?
  phoneNumber            String?
  nationality            String?
  nationalIdentityNumber String?
  dob                    String? // mm-dd-yyyy
  placeOfBirth           String?
  sourceOfFunds          String
  email                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}

model OffRampProviderCredential {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @unique
  username    String
  accessToken String
  idToken     String?
  apiUrl      String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContractEvent {
  cashOutObligation OffRampPayoutJob?
  id                String            @id @default(uuid()) @db.Uuid
  deploymentId      String            @db.Uuid
  eventId           String            @unique
  kind              EventKind
  ledger            Int
  txHash            String
  payload           Json
  decodedData       Json?
  occurredAt        DateTime

  deployment         Deployment          @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  emailNotifications EmailNotification[]
  cashOutJobFailure  CashOutJobFailure?

  @@index([deploymentId, txHash])
  @@index([deploymentId, occurredAt(sort: Desc)])
  @@index([deploymentId, ledger, eventId])
  // cron/auto-release: "any RECEIVE past ledger N for this deployment".
  @@index([deploymentId, kind, ledger])
}

model EmailNotification {
  deploymentId    String?  @db.Uuid
  txHash          String?
  kind            String?
  deliveryKey     String?  @unique
  id              String   @id @default(uuid()) @db.Uuid
  contractEventId String   @db.Uuid
  nodeId          String
  address         String?
  recipient       String
  status          String
  error           String?
  sentAt          DateTime @default(now())

  contractEvent ContractEvent @relation(fields: [contractEventId], references: [id], onDelete: Cascade)

  @@unique([contractEventId, nodeId, address])
  @@index([contractEventId])
  @@index([deploymentId, txHash])
}

model EventCursor {
  deploymentId String     @id @db.Uuid
  lastLedger   Int
  updatedAt    DateTime   @updatedAt
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

/// Who signed a transaction this app submitted, and under which app account.
/// `userId` is the *signer's* session user when there was one. The public
/// trigger page has none, and the deployment's owner is deliberately NOT
/// substituted: an anonymous visitor can fund someone else's deployment.
/// `AuditLog.metadata` carries a display copy of `signerAddress`; this table
/// is the system of record, because it is indexed and its write is not
/// best-effort. See lib/signed-tx.ts.
model SignedTransaction {
  developerApiTokenId String?             @db.Uuid
  developerApiToken   DeveloperApiToken?  @relation(fields: [developerApiTokenId], references: [id], onDelete: Restrict)
  callerAccountId     String?             @db.Uuid
  callerAccount       User?               @relation("transactionCaller", fields: [callerAccountId], references: [id], onDelete: SetNull)
  trackingVersion     String?
  audience            AnalyticsAudience   @default(UNCLASSIFIED)
  apiTokenId          String?             @db.Uuid
  outcome             TransactionOutcome?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  rejectedAt          DateTime?
  ledger              Int?
  failureCode         String?
  nextCheckAt         DateTime?
  lastCheckedAt       DateTime?
  checkAttempts       Int                 @default(0)
  submissionRevision  Int                 @default(0)
  outcomeRevision     Int                 @default(0)
  apiToken            DeploymentApiToken? @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  id                  String              @id @default(uuid()) @db.Uuid
  /// Lowercase hex, the hash the network knows the envelope by.
  txHash              String              @unique
  /// Always the G… form, so it joins to every other address column.
  signerAddress       String
  /// Set only for a fee bump, where it differs from the signer.
  feeSourceAddress    String?
  /// The M… address when the source was muxed.
  muxedSource         String?
  isFeeBump           Boolean             @default(false)
  /// A signature on the envelope verifies against the source key.
  signedBySource      Boolean             @default(true)
  /// The session user who submitted the envelope; the app has no wallet↔user binding.
  userId              String?             @db.Uuid
  deploymentId        String?             @db.Uuid
  kind                SignedTxKind
  network             String
  ip                  String?
  createdAt           DateTime            @default(now())

  user       User?       @relation("signingSession", fields: [userId], references: [id], onDelete: SetNull)
  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([callerAccountId, createdAt])
  @@index([trackingVersion, network, audience, createdAt])
  @@index([outcome, nextCheckAt])
  @@index([developerApiTokenId, createdAt])
  @@index([apiTokenId, createdAt])
  @@index([signerAddress, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([deploymentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model CashOutJobFailure {
  id                String    @id @default(uuid()) @db.Uuid
  deploymentId      String    @db.Uuid
  contractEventId   String    @unique @db.Uuid
  sourceAddress     String
  amountStroops     String
  bankAccountName   String
  bankAccountNumber String
  bankCode          String
  error             String?
  retriedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deployment    Deployment    @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  contractEvent ContractEvent @relation(fields: [contractEventId], references: [id], onDelete: Cascade)

  @@index([deploymentId, createdAt])
}

model FileAsset {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  storageKey  String   @unique
  filename    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
}

// Rotates current templates/factory independently of deployments, including failures.
model TtlMaintenanceState {
  network      String  @id
  sharedOffset Int     @default(0)
  sharedFirst  Boolean @default(false)
}

// A fixed campaign ceiling. Reservations never expire or credit expected refunds.
model TransactionFeeBudget {
  network               String
  name                  String
  limitStroops          String
  committedStroops      String    @default("0")
  createdAt             DateTime  @default(now())
  fixtureSetupClaimedAt DateTime?

  reservations TransactionFeeReservation[]

  @@id([network, name])
}

model TransactionFeeReservation {
  id                 String   @id @default(uuid()) @db.Uuid
  network            String
  budgetName         String
  txHash             String
  payer              String
  declaredFeeStroops String
  purpose            String
  createdAt          DateTime @default(now())

  budget TransactionFeeBudget @relation(fields: [network, budgetName], references: [network, name], onDelete: Restrict)

  @@unique([network, txHash])
  @@index([network, budgetName, createdAt])
}

/// Durable webhook event reservation. Keys never expire/reopen automatically.
/// Store digests and transaction evidence, never callback bodies or signed envelopes.
model WebhookAttempt {
  id           String     @id @default(uuid()) @db.Uuid
  deploymentId String     @db.Uuid
  network      String
  keyHash      String
  requestHash  String
  status       String     @default("PREPARING")
  txHash       String?
  acceptedAt   DateTime?
  ledger       Int?
  errorCode    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, keyHash])
  @@index([deploymentId, network, txHash])
}

/// Future-only API telemetry. IDs are snapshots, not identity claims for unknown callers.
model ApiRequestLog {
  id                   String            @id @db.Uuid
  requestId            String
  occurredAt           DateTime
  accountId            String?           @db.Uuid
  tokenCreatorId       String?           @db.Uuid
  apiTokenId           String?           @db.Uuid
  deploymentId         String?           @db.Uuid
  txHash               String?
  preparationRequestId String?           @db.Uuid
  callerType           String
  method               String
  endpoint             String
  status               Int
  durationMs           Int
  errorCode            String?
  network              String
  environment          String
  appVersion           String
  audience             AnalyticsAudience
  trackingVersion      String
  persistedAt          DateTime          @default(now())

  @@index([occurredAt, id])
  @@index([network, environment, audience, occurredAt])
  @@index([accountId, occurredAt])
  @@index([apiTokenId, occurredAt])
  @@index([endpoint, occurredAt])
  @@index([txHash])
  @@index([preparationRequestId, apiTokenId])
}

/// Identity-free daily totals survive the 30-day raw request retention policy.
model ApiRequestDailyAggregate {
  day                    DateTime          @db.Date
  network                String
  environment            String
  audience               AnalyticsAudience
  trackingVersion        String
  endpoint               String
  method                 String
  requests               BigInt            @default(0)
  errors                 BigInt            @default(0)
  authenticationFailures BigInt            @default(0)
  rateLimited            BigInt            @default(0)
  totalDurationMs        BigInt            @default(0)
  minDurationMs          Int
  maxDurationMs          Int
  lastOccurredAt         DateTime

  @@id([day, network, environment, audience, trackingVersion, endpoint, method])
  @@index([network, environment, audience, trackingVersion, day], map: "ApiRequestDailyAggregate_scope_day_idx")
}

/// Minimal durable deduplication receipts prevent recounting after raw rows expire.
/// No account, token, deployment, wallet, timestamp or payload is retained here.
model ApiRequestAggregateReceipt {
  id String @id @db.Uuid
}

model ApiRequestDailyCoverage {
  version      String   @id
  coverageFrom DateTime
  backfilledAt DateTime @default(now())
}

/// Only validated provider identity is retained; no OAuth tokens are stored.
model GoogleIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @default("google")
  providerAccountId String
  userId            String   @db.Uuid
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

/// Short-lived, one-use consent to link Google to a recently authenticated account.
model GoogleLinkIntent {
  id             String   @id @default(uuid()) @db.Uuid
  tokenHash      String   @unique
  userId         String   @db.Uuid
  sessionVersion Int
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Admission records are retained with financial history. OPEN after a process
// crash requires verified operator reconciliation, never timeout completion.
model DeploymentWork {
  id                     String               @id @default(uuid()) @db.Uuid
  deploymentId           String               @db.Uuid
  kind                   String
  state                  DeploymentWorkState  @default(OPEN)
  blocker                String?
  createdAt              DateTime             @default(now())
  completedAt            DateTime?
  reconciliationEvidence String?
  deployment             Deployment           @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  transactions           ServiceTransaction[]

  @@index([deploymentId, state])
}

model ServiceTransaction {
  id        String                  @id @default(uuid()) @db.Uuid
  workId    String                  @db.Uuid
  txHash    String
  transport String
  state     ServiceTransactionState @default(PENDING)
  ledger    Int?
  createdAt DateTime                @default(now())
  work      DeploymentWork          @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@unique([workId, txHash])
  @@index([txHash, state])
  @@index([state, createdAt])
}

// Reusable event invitations. The raw code is shown only when created.
model GoogleSignupCode {
  id         String               @id @default(uuid()) @db.Uuid
  label      String
  codeHash   String               @unique
  createdAt  DateTime             @default(now())
  expiresAt  DateTime
  disabledAt DateTime?
  intents    GoogleSignupIntent[]
}

// A single browser authorization, never the reusable invitation itself.
model GoogleSignupIntent {
  username  String?
  id        String           @id @default(uuid()) @db.Uuid
  tokenHash String           @unique
  codeId    String           @db.Uuid
  expiresAt DateTime
  code      GoogleSignupCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([codeId])
}

enum WalletControlState {
  PREPARED
  SUBMITTING
  SUCCESS
  FAILED
  EXPIRED
}

// Exact unsigned transaction binding; no customer signatures or keys are stored.
model WalletControlIntent {
  id                String             @id @default(uuid()) @db.Uuid
  deploymentId      String             @db.Uuid
  deployment        Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  network           String
  nodeId            String
  contractAddress   String
  action            String
  walletAddress     String
  txHash            String             @unique
  maxTime           String
  preparationLedger Int
  // PREPARED -> SUBMITTING -> SUCCESS|FAILED|EXPIRED. Uncertainty never clears a reservation.
  state             WalletControlState @default(PREPARED)
  ledger            Int?
  createdAt         DateTime           @default(now())
  submittedAt       DateTime?
  completedAt       DateTime?

  @@index([deploymentId, network, nodeId, state])
}
