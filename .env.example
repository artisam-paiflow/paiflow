# Copy to .env and fill the blanks. This file is the source of truth for
# configuration: every variable the app reads should appear here, whether it is
# validated by lib/env.ts or read straight from process.env.
#
# Blank value  = you must supply one.
# Commented out = optional; the value shown is the default the code already uses.

# ---- App ----
# NODE_ENV is set by next-build itself; leave unset locally
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Auth ----
# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated browser origins passkeys may be used from, e.g.
# https://paiflow.xyz,https://beta.app.paiflow.xyz — bare origins only (scheme, host,
# optional port), since that is all a browser sends. A path, query or credential is
# refused at startup. Leave blank to use AUTH_URL; set it wherever one service answers
# on several hostnames.
AUTH_ORIGINS=
AUTH_RP_ID=localhost
AUTH_RP_NAME=Paiflow
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
# pnpm db:seed refuses to re-seed a production database unless this is "true".
# ALLOW_RESEED=false

# Optional second admin for private test access. Seeded independently of the
# ALLOW_RESEED guard above; prisma/seed.ts skips it entirely when
# JUDGE_SEED_PASSWORD is unset. These credentials are never displayed anywhere.
JUDGE_SEED_USERNAME=judge
JUDGE_SEED_PASSWORD=

# Offers "try the sandbox" on the login page: one throwaway SANDBOX-role user
# per visitor, limited to the builder and deploy screens (lib/sandbox-paths.ts).
# Testnet only — env() refuses to boot with this true and
# STELLAR_NETWORK=mainnet.
SANDBOX_ENABLED=false

# ---- Database ----
DATABASE_URL=postgresql://paiflow:paiflow@localhost:5432/paiflow?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- File storage (dev = MinIO; prod = Railway Volume) ----
FILE_STORAGE_DRIVER=minio
FILE_STORAGE_PATH=/data/files
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=paiflow
MINIO_SECRET_KEY=paiflow-dev-secret
MINIO_BUCKET=paiflow-dev

# ---- Stellar ----
# Network is pinned per environment:
#   - dev / staging → STELLAR_NETWORK=testnet
#   - production    → STELLAR_NETWORK=mainnet
# There is no per-deploy picker. Switch environments by switching this var.
STELLAR_NETWORK=testnet

# Testnet endpoints (required when STELLAR_NETWORK=testnet)
STELLAR_NETWORK_PASSPHRASE_TESTNET=Test SDF Network ; September 2015
STELLAR_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
# Friendbot is testnet-only (leave empty/unset when STELLAR_NETWORK=mainnet).
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Mainnet endpoints (required when STELLAR_NETWORK=mainnet). The defaults
# below are SDF's public endpoints — uncomment / override only if you run
# your own RPC.
# STELLAR_NETWORK_PASSPHRASE_MAINNET=Public Global Stellar Network ; September 2015
# STELLAR_HORIZON_URL_MAINNET=https://horizon.stellar.org
# STELLAR_SOROBAN_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com

# Address of the deployed factory contract. Written by
# `pnpm contracts:deploy-factory`. Without it preparePipelineDeployTx() throws
# before it builds a transaction and nothing can deploy.
STELLAR_FACTORY_ADDRESS_TESTNET=
# STELLAR_FACTORY_ADDRESS_MAINNET=

# Soroswap router the Swap block calls. Pinned per network and injected at
# deploy time; never stored on a flow graph. Soroswap redeploys its testnet
# router on every reset — the canonical list is soroswap/core
# public/testnet.contracts.json. Deploying a flow with a Swap block fails with a
# plain-English error while this is unset.
STELLAR_SOROSWAP_ROUTER_TESTNET=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
# STELLAR_SOROSWAP_ROUTER_MAINNET=

# One hash per TemplateKind, written by `pnpm contracts:upload --network=...`.
# scripts/update-hashes.ts holds the authoritative kind list; keep these in
# step with it. At request time lib/stellar/config.ts reads the ContractTemplate
# and FactoryDeployment tables FIRST and only falls back to these vars.
STELLAR_WASM_HASH_FACTORY_TESTNET=
STELLAR_WASM_HASH_SPLITTER_TESTNET=
STELLAR_WASM_HASH_STREAMER_TESTNET=
STELLAR_WASM_HASH_CONDITIONAL_TESTNET=
STELLAR_WASM_HASH_DEPOSIT_TRIGGER_TESTNET=
STELLAR_WASM_HASH_ROUTER_TESTNET=
STELLAR_WASM_HASH_TIMELOCK_TESTNET=
STELLAR_WASM_HASH_WEBHOOK_TESTNET=
STELLAR_WASM_HASH_SUBSCRIPTION_TESTNET=
STELLAR_WASM_HASH_ORACLE_TESTNET=
STELLAR_WASM_HASH_MULTISIG_TESTNET=
STELLAR_WASM_HASH_SWAPPER_TESTNET=
STELLAR_WASM_HASH_YIELD_TESTNET=
STELLAR_WASM_HASH_PAYER_TESTNET=
STELLAR_WASM_HASH_PAYROLL_TESTNET=
STELLAR_WASM_HASH_CASH_OUT_TESTNET=
# Dev-mode (on-chain-mutable) variants — see docs/design/2026-06-24-dev-mode-mutable-flows.md
STELLAR_WASM_HASH_PAYER_DEV_TESTNET=
STELLAR_WASM_HASH_SPLITTER_DEV_TESTNET=
STELLAR_WASM_HASH_SUBSCRIPTION_DEV_TESTNET=
STELLAR_WASM_HASH_CASH_OUT_DEV_TESTNET=

# Populated by `pnpm contracts:upload --network=mainnet` (see docs/mainnet-cutover.md)
STELLAR_WASM_HASH_FACTORY_MAINNET=
STELLAR_WASM_HASH_SPLITTER_MAINNET=
STELLAR_WASM_HASH_STREAMER_MAINNET=
STELLAR_WASM_HASH_CONDITIONAL_MAINNET=
STELLAR_WASM_HASH_DEPOSIT_TRIGGER_MAINNET=
STELLAR_WASM_HASH_ROUTER_MAINNET=
STELLAR_WASM_HASH_TIMELOCK_MAINNET=
STELLAR_WASM_HASH_WEBHOOK_MAINNET=
STELLAR_WASM_HASH_SUBSCRIPTION_MAINNET=
STELLAR_WASM_HASH_ORACLE_MAINNET=
STELLAR_WASM_HASH_MULTISIG_MAINNET=
STELLAR_WASM_HASH_SWAPPER_MAINNET=
STELLAR_WASM_HASH_YIELD_MAINNET=
STELLAR_WASM_HASH_PAYER_MAINNET=
STELLAR_WASM_HASH_PAYROLL_MAINNET=
STELLAR_WASM_HASH_CASH_OUT_MAINNET=
STELLAR_WASM_HASH_PAYER_DEV_MAINNET=
STELLAR_WASM_HASH_SPLITTER_DEV_MAINNET=
STELLAR_WASM_HASH_SUBSCRIPTION_DEV_MAINNET=
STELLAR_WASM_HASH_CASH_OUT_DEV_MAINNET=

# ---- Contract tooling (scripts only, never read by the app) ----
# A funded Stellar secret key for the target network. It pays for every WASM
# upload and for the factory deployment: `pnpm contracts:upload` and
# `pnpm contracts:deploy-factory` both refuse to run without it.
# Read straight from process.env, so it is not in lib/env.ts.
# UPLOADER_SECRET=

# ---- Relayer ----
# Paiflow's own Stellar account — the ONE server-held key. It signs the
# *_by_relayer contract calls that run automation without the user signing each
# time: payroll charges, subscription charges, streamer claims and timelock
# releases. Optional, but when it is unset in production every cron/* job
# silently no-ops — nothing errors, the work just never happens.
# The account must be funded so it can pay transaction fees.
STELLAR_RELAYER_SECRET_KEY=
# Public address of that account. When unset the admin address is used.
# STELLAR_RELAYER_ADDRESS=

# ---- Cron ----
# Shared secret for the x-cron-secret header on /api/cron/*. These routes are
# public in middleware.ts and several sign with the relayer key, so in
# production requireCronSecret() refuses EVERY request unless this is set and
# at least 32 characters. Left unset it only opens the routes on a developer
# machine (NODE_ENV != production). Generate with `openssl rand -base64 48`.
CRON_SECRET=

# Per-run limits. Defaults shown.
# PAYROLL_MAX_CATCHUP_PER_RUN=5
# SUBSCRIPTION_MAX_CATCHUP_PER_RUN=5
# OFFRAMP_BATCH_SIZE=50
# OFFRAMP_MAX_RETRY_ATTEMPTS=3
# OFFRAMP_JOB_LEASE_MS=600000
# OFFRAMP_JOB_CONCURRENCY=3

# ---- Wallets ----
# WalletConnect project id, from https://cloud.reown.com. Required for the
# mobile wallet path (xBull / LOBSTR); desktop Freighter does not use it.
# Read directly from process.env because NEXT_PUBLIC_* must be a literal access
# for the bundler to inline it, so lib/env.ts cannot validate it. When unset:
# desktop wallet pickers offer Freighter only, and mobile wallet connection
# fails immediately with a message naming this variable (mobile has no other
# wallet path). The WalletConnect SDK itself does not reject a missing id.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# ---- Flow amount caps ----
# Temporary hard limits on fixed split/pay amounts. These are public because
# flow validation runs in the browser (lib/flows/limits.ts). Values are whole
# tokens (XLM / USDC) and are converted to stroops at runtime. Bounds are
# inclusive; set a bound to 0 to disable just that bound (both 0 = off).
# They apply to every provider, including the mock off-ramp.
NEXT_PUBLIC_SPLITTER_XLM_MIN=150
NEXT_PUBLIC_SPLITTER_XLM_MAX=500
NEXT_PUBLIC_SPLITTER_USDC_MIN=30
NEXT_PUBLIC_SPLITTER_USDC_MAX=110

# ---- AI / Raft Log ----
# Generic OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Groq provider (recommended for Raft Log)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL_PRIMARY=whisper-large-v3
GROQ_STT_MODEL_FALLBACK=whisper-large-v3-turbo
# Comma-separated chat models tried in order when GROQ_MODEL fails. Read
# directly from process.env in lib/ai/groq.ts, so it is not in lib/env.ts.
# GROQ_FALLBACK_MODELS=

# ---- Email (Resend) ----
# Optional in dev: when RESEND_API_KEY is unset, lib/mail.ts logs the email
# payload to stdout instead of delivering. Required in prod for password
# reset to actually send. Sign up at https://resend.com.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding@resend.dev (test-only —
# delivers to your verified Resend account inbox only).
EMAIL_FROM=

# ---- Dev mode (machine-driven flows) ----
# Bearer-style token for the /api/deployments/:id/dev-* endpoints, sent as
# `x-dev-api-secret`. When set, it authenticates in place of a user session —
# note it does not enforce deployment ownership (issue #247).
# DEV_API_SECRET=

# ---- Off-ramp provider (e.g. PDAX) ----
# Provider: "mock" for local dev/tests, "pdax" for PDAX Institutional API UAT.
# The default is "mock": fiat payouts are SIMULATED and no money reaches a bank.
OFFRAMP_PROVIDER=mock

# Relayer-controlled holding address that cash_out nodes sink USDC to before
# the off-chain leg. When unset the relayer address is used.
# OFFRAMP_TREASURY_ADDRESS_TESTNET=
# OFFRAMP_TREASURY_ADDRESS_MAINNET=

# OFFRAMP_PROVIDER=pdax
# OFFRAMP_API_URL=https://uat.services.sandbox.pdax.ph/api/pdax-api
#
# PDAX tokens rotate frequently. Store the current access/id tokens in the
# database via Admin → Off-ramp (/admin/offramp). The refresh token must live
# ONLY in this env var, never in the database.
# OFFRAMP_USERNAME=
# OFFRAMP_ACCESS_TOKEN=
# OFFRAMP_ID_TOKEN=
# OFFRAMP_REFRESH_TOKEN=
# Legacy, kept for backwards compatibility; not used for Bearer auth.
# OFFRAMP_API_KEY=
#
# Guards the /api/webhooks/offramp callback with a ?token= check:
#   set to a secret  -> 401 unless the query token matches
#   set to "skip"    -> check disabled (also satisfies the production guard)
#   unset, non-prod  -> check skipped
#   unset, PRODUCTION-> the handler throws and EVERY webhook fails
# OFFRAMP_WEBHOOK_SECRET=
# PDAX defaults (production and UAT institutional wallets both use USDC;
# Stellar USDC / USDCXLM deposits are disabled in UAT):
# OFFRAMP_ASSET_CODE=USDC
# OFFRAMP_NETWORK=XLM_USDC_T_CEKS
# OFFRAMP_CHANNEL=InstaPay
# Native XLM PDAX deposit credentials. When both address and memo are set,
# process-offramp-jobs will forward XLM from the treasury to PDAX before
# quoting/trading. The memo is the numeric tag PDAX requires to credit the
# deposit to your institutional balance.
# OFFRAMP_PDAX_DEPOSIT_ADDRESS_TESTNET=GCK2MUVH6TABTXT4247CIEC5EO24CQQ4MZNW7EGBTP3TPGALLQI7P34G
# OFFRAMP_PDAX_DEPOSIT_MEMO_TESTNET=3777239912
# OFFRAMP_PDAX_DEPOSIT_ADDRESS_MAINNET=
# OFFRAMP_PDAX_DEPOSIT_MEMO_MAINNET=
#
# IMPORTANT: PDAX UAT cannot accept Stellar USDC (USDCXLM) deposits. The
# employer must pre-fund the PDAX institutional balance with USDC off-chain.
# The on-chain treasury still sinks Stellar USDC as a bookkeeping proof.
# For native XLM, use the PDAX deposit credentials above instead.
#
# PDAX UAT test beneficiary bank accounts (reference only — NOT read by the app;
# bank details are entered per-recipient in the flow config). Use these valid
# sandbox accounts to avoid AC01 (incorrect account number) rejections:
#   BASECPH (Security Bank)  -> 0000042001461
#   BACTBPH (CTBC Bank PH)   -> 001700062270

# ---- Analytics (PostHog) ----
# Alpha-round usage analytics and session replay (lib/analytics/). Set ONLY on
# the beta service: leaving NEXT_PUBLIC_POSTHOG_KEY empty disables analytics
# entirely. Both NEXT_PUBLIC_* values are inlined at build time, so they must be
# present as Railway build variables, not just runtime ones. The browser talks to
# PostHog through the /ingest proxy in app/ingest/[...path]/route.ts (US cloud,
# hard-coded there; it also reads the key at runtime and 404s without it);
# POSTHOG_HOST is the server-side capture endpoint.
NEXT_PUBLIC_POSTHOG_KEY=
# local | staging | beta
NEXT_PUBLIC_APP_ENV=local
POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_APP_VERSION is derived in next.config.ts from RAILWAY_GIT_COMMIT_SHA.

# ---- Optional ----
SENTRY_DSN=
HIBP_CHECK_ENABLED=false
# In-app cache for contract reads (lib/contract-read-cache.ts). Defaults shown.
# CONTRACT_READ_CACHE_ENABLED=true
# CONTRACT_READ_CACHE_TTL_SECONDS=300

# ---- Tests ----
# Absolute path to a Chromium binary for the Playwright e2e run. Only needed
# when the bundled download is unavailable.
# CHROMIUM_PATH=
