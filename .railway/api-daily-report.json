{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": ".railway/api-daily-report.Dockerfile"
  },
  "deploy": {
    "startCommand": "pnpm analytics:api-daily-cron --network testnet --environment beta --audience EXTERNAL --dir /reports/api --lookback-days 3",
    "cronSchedule": "0 1 * * *",
    "requiredMountPath": "/reports",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
