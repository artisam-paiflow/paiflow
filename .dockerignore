# Allow only the source/configuration needed to build the app. Private checkout
# state, evidence, credentials and local environment files never enter the context.
**
!Dockerfile
!.dockerignore
!.npmrc
!package.json
!pnpm-lock.yaml
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!auth.ts
!auth.config.ts
!middleware.ts
!instrumentation.ts
!instrumentation-client.ts
!sentry.server.config.ts
!sentry.edge.config.ts
!prisma.config.ts
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!public/
!public/**
!prisma/
!prisma/**
!scripts/
!scripts/**
!packages/
!packages/sdk/
!packages/sdk/**

# Local acceptance tools import fixtures intentionally excluded from the image.
# Keep other scripts available to the separate daily-report image's build context.
scripts/check-instance-artifacts.ts
scripts/generate-instance-acceptance.ts
scripts/generate-execution-acceptance.ts
scripts/generate-mutation-acceptance.ts

# Reinstate exclusions inside the allowed source directories too.
**/.env*
**/.git
**/.git/**
**/.worktrees
**/.worktrees/**
**/.codex
**/.codex/**
**/.agents
**/.agents/**
**/.aws
**/.aws/**
**/.auth
**/.auth/**
**/private
**/private/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/dist
**/dist/**
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tgz
**/*memory*.md
**/*.tsbuildinfo
